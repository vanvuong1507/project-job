{
  "name": "frontend",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@frontend/client",
    "dev:admin": "turbo run dev --filter=@frontend/admin",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:evidence": "E2E_EVIDENCE=1 turbo run test:e2e",
    "storybook": "turbo run storybook --filter=@frontend/ui",
    "build-storybook": "turbo run build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test build build-storybook",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "skills:sync": "node scripts/sync-next-skills.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.8",
    "typescript": "catalog:"
  }
}
