# Copy to .env. Validated by src/env.ts (an invalid value fails `next dev` / `next build`).

# Where dashboard data comes from:
#   mock — in-process fixtures (src/server/revenue-trend/sources/mock); no backend needed
#   api  — the real backend (../backend) at API_URL (server-side only; the browser never calls it)
DATA_SOURCE=mock
# API_URL=http://localhost:4000

# Expose the mock JSON endpoint GET /api/dashboard/revenue-trend (for tools and E2E). Keep false in production.
ENABLE_MOCK_API=true

# Optional: artificial latency (ms) for the mock source, to see loading skeletons.
# MOCK_DELAY_MS=800

# Public origin of the site (metadataBase, canonical links, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: endpoint that receives Core Web Vitals beacons.
# NEXT_PUBLIC_VITALS_URL=

# Server log level: debug | info | warn | error (JSON lines in production).
# LOG_LEVEL=info

# Set to "true" to skip env validation (e.g. building a Docker image without secrets).
# SKIP_ENV_VALIDATION=
