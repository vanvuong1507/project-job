# Copy to .env. Validated by src/env.ts (an invalid value fails `next dev` / `next build`).

# Public URL of the client dashboard, for "View dashboard" links.
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# Where admin data comes from:
#   mock — file-backed store (.mock-data/db.json, from src/server/sources/mock); no backend needed
#   api  — the real backend (../backend) at API_URL, called server-side only
DATA_SOURCE=mock
# API_URL=http://localhost:4000

# HMAC key of the session JWT (≥ 32 chars; `openssl rand -hex 32`), used in both modes.
# api mode: MUST equal the backend's JWT_SECRET (the backend issues the token, this app verifies it).
# The default below equals the backend's development default. Never use it in production.
AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789

# Expose the mock JSON API (/api/auth/*, /api/admin/*) for tools and E2E. Keep false in production.
ENABLE_MOCK_API=true

# --- mock mode only ------------------------------------------------------------------------
# Seeded accounts (hashed when .mock-data is created). Defaults match the backend seed:
#   admin@example.com / admin123 (ADMIN) · viewer@example.com / viewer123 (VIEWER, read-only)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin123
# ADMIN_NAME=Restaurant Admin
# VIEWER_EMAIL=viewer@example.com
# VIEWER_PASSWORD=viewer123
# VIEWER_NAME=Read-only Viewer
# Artificial latency (ms) to see loading states.
# MOCK_DELAY_MS=800

# Server log level: debug | info | warn | error (JSON lines in production).
# LOG_LEVEL=info

# Set to "true" to skip env validation (e.g. building an image without secrets).
# SKIP_ENV_VALIDATION=
