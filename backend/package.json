{
  "name": "revenue-dashboard-backend",
  "version": "1.0.0",
  "description": "REST API for the Revenue Trend dashboard and its admin (NestJS + TypeORM + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.12.0"
  },
  "scripts": {
    "bootstrap": "pnpm install && node scripts/doctor.mjs --env-only && pnpm db:setup",
    "doctor": "node scripts/doctor.mjs",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "oxlint src/ test/ scripts/",
    "lint:fix": "oxlint --fix src/ test/ scripts/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:create": "nest build && node dist/database/scripts/create-db.js",
    "db:migrate": "nest build && node dist/database/scripts/migrate.js",
    "db:revert": "nest build && node dist/database/scripts/revert.js",
    "db:seed": "nest build && node dist/database/scripts/seed.js",
    "db:reset": "nest build && node dist/database/scripts/reset.js",
    "db:setup": "nest build && node dist/database/scripts/create-db.js && node dist/database/scripts/migrate.js && node dist/database/scripts/seed.js",
    "migration:generate": "node scripts/migration.mjs generate",
    "migration:create": "node scripts/migration.mjs create",
    "migration:check": "node scripts/migration.mjs check",
    "migration:show": "node scripts/migration.mjs show",
    "migration:run": "nest build && node dist/database/scripts/migrate.js",
    "migration:revert": "nest build && node dist/database/scripts/revert.js",
    "skills:sync": "node scripts/sync-skills.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
