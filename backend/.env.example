# ═══ Revenue Dashboard API — environment ═══════════════════════════════════════════════════
# Copy to `.env` (`cp .env.example .env`). Every variable is validated at startup; a wrong value
# stops the API with a list of the problems. Defaults below work for local development as-is.

# ─── Server ─────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Express `trust proxy`: loopback (default) | true | false | <hop count> | <IPs/subnets>.
# Behind a reverse proxy/load balancer set it so client IPs (rate limiting) are correct.
# The frontend admin server forwards the user's IP in X-Forwarded-For: its address must be trusted
# (loopback covers admin and API on the same host; otherwise e.g. `loopback, 10.0.0.12`).
TRUST_PROXY=loopback

# ─── Database (PostgreSQL 13+, 16 recommended) ──────────────────────────────────────────────
# postgres://<user>:<password>@<host>:<port>/<database>   (managed Postgres: add ?sslmode=require)
# The user needs CREATEDB so `pnpm db:create` and the e2e tests (<database>_test) can create databases.
DATABASE_URL=postgres://revenue:revenue@localhost:5432/revenue_dashboard
DB_POOL_MAX=10
# Log every SQL statement (debugging only).
DB_LOGGING=false

# ─── Auth ───────────────────────────────────────────────────────────────────────────────────
# HMAC key for the session JWT (≥ 32 chars): openssl rand -hex 32
# The frontend admin app verifies the same token: its AUTH_SECRET must equal this value.
# This example value is refused when NODE_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
# `Secure` flag of the session cookie (HTTPS only). Empty → true in production, false otherwise.
COOKIE_SECURE=
# Login requests allowed per IP per minute (all attempts).
LOGIN_RATE_LIMIT=30
# Failed logins per email + IP before that pair is locked for LOGIN_LOCKOUT_MINUTES (429 + Retry-After).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Sessions: a short-lived access token (JWT) + a rotating refresh token (see docs/API.md).
# Access token lifetime (1–60). It can't be revoked before it expires, so keep it short.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token: sliding lifetime (each refresh extends it) …
REFRESH_TOKEN_TTL_DAYS=7
# … but never beyond this many days after sign-in.
SESSION_MAX_DAYS=30
# A just-rotated refresh token is still accepted this long (parallel requests); later reuse = theft → revoke.
REFRESH_REUSE_LEEWAY_SECONDS=30
# Refresh requests per IP per minute.
REFRESH_RATE_LIMIT=120

# ─── CORS ───────────────────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API with cookies: client dashboard (3000) + admin (3001).
WEB_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging & docs ─────────────────────────────────────────────────────────────────────────
# fatal | error | warn | log | debug | verbose (most verbose level printed)
LOG_LEVEL=log
# json | pretty. Empty → json in production, pretty otherwise.
LOG_FORMAT=
# Swagger UI at /api/docs. Empty → on, except in production.
SWAGGER_ENABLED=

# ─── Seed accounts (`pnpm db:seed` only — the API itself doesn't read these) ───────────────
# Same defaults as the frontend's apps/admin/.env.example.
# admin  → role ADMIN: full access
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Restaurant Admin
# client → role VIEWER: read-only (writes answer 403)
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=viewer123
VIEWER_NAME=Read-only Viewer
